# ---- Server ----
PORT=5000
NODE_ENV=development

# MongoDB connection string (REQUIRED)
#  - Local: install MongoDB Community Server https://www.mongodb.com/try/download/community  -> mongodb://127.0.0.1:27017/nagrivanta
#  - Cloud: MongoDB Atlas free M0 cluster https://www.mongodb.com/cloud/atlas/register
#           Atlas -> Database -> Connect -> Drivers -> copy the "mongodb+srv://..." string, put your DB user/password in it
#           and allow your IP under Network Access.
MONGODB_URI=mongodb://127.0.0.1:27017/nagrivanta

# JWT signing secret (REQUIRED) - any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Comma-separated origins allowed to call the API (web dev server, Expo web)
CORS_ORIGINS=http://localhost:5173,http://localhost:8081

# ---- AI (OPTIONAL) ----
# Google Gemini API key. Get one free at https://aistudio.google.com/app/apikey
# (sign in -> "Create API key"). New projects may need billing enabled: https://aistudio.google.com/billing
# Leave empty to use the built-in offline model (Naive Bayes trained on the bundled datasets).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
AI_TIMEOUT_MS=8000

# How often (minutes) the SLA job checks for overdue complaints
SLA_CHECK_MINUTES=5

# ---- Optional ----
# Password for the demo accounts created by `npm run seed`. Set your own for any shared/online database.
SEED_PASSWORD=
# Secret that protects GET /api/v1/jobs/sla (Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>").
# Any long random string.
CRON_SECRET=

# ---- Features (all optional) ----
# Smart routing: auto-assign confident reports to the right department and least-loaded officer
AUTO_ASSIGN=true
# Time zone used to read date-only filters like ?to=2026-10-28
APP_TZ_OFFSET=+05:30
# Predictive risk alerts use the free Open-Meteo forecast (no key). Set to "off" to use history only.
RISK_WEATHER=on
# Open311 GeoReport v2: comma-separated API keys you hand to partner systems (any long random strings)
OPEN311_API_KEYS=
# Outbound webhook for case events (signed with HMAC-SHA256 in header X-NagriVanta-Signature)
WEBHOOK_URL=
WEBHOOK_SECRET=
