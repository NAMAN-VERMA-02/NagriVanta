# ---- Server ----
PORT=5000
NODE_ENV=development

# MongoDB connection string (REQUIRED)
#  - Local: install MongoDB Community Server https://www.mongodb.com/try/download/community  -> mongodb://127.0.0.1:27017/civiclens
#  - Cloud: MongoDB Atlas free M0 cluster https://www.mongodb.com/cloud/atlas/register
#           Atlas -> Database -> Connect -> Drivers -> copy the "mongodb+srv://..." string, put your DB user/password in it
#           and allow your IP under Network Access.
MONGODB_URI=mongodb://127.0.0.1:27017/civiclens

# JWT signing secret (REQUIRED) - any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Comma-separated origins allowed to call the API (web dev server, Expo web)
CORS_ORIGINS=http://localhost:5173,http://localhost:8081

# ---- AI (OPTIONAL) ----
# Google Gemini API key. Get one free at https://aistudio.google.com/app/apikey
# (sign in with a Google account -> "Create API key"). Leave empty to use the built-in rule-based classifier.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_TIMEOUT_MS=8000

# How often (minutes) the SLA job checks for overdue complaints
SLA_CHECK_MINUTES=5
