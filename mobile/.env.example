# URL of the NagriVanta API as seen FROM YOUR PHONE (REQUIRED).
# "localhost" will not work on a real device. Use your computer's LAN IP:
#   Windows: run `ipconfig` -> "IPv4 Address" (e.g. 192.168.1.5)
#   macOS/Linux: run `ipconfig getifaddr en0` or `hostname -I`
# Android emulator can use http://10.0.2.2:5000 ; iOS simulator / Expo web can use http://localhost:5000
EXPO_PUBLIC_API_URL=http://192.168.1.5:5000
